# Production URLs — ConcordiaOrbis
# Site:  https://concordiaorbis-platform-one.vercel.app  (Vercel)
# API:   https://concordiaorbis-platform.onrender.com    (Render)
# Company site (Paystack / about): deploy the `website/` folder as a second Vercel project
#   then set NEXT_PUBLIC_COMPANY_SITE_URL on the trading app.

# ─── Render → concordiaorbis-platform → Environment ──────────────────────────
# FRONTEND_URL and GOOGLE_REDIRECT_URI are set by render.yaml on Blueprint sync.
# Copy these manually from the old ani-platform-api service:
#
#   JWT_SECRET=...
#   JWT_REFRESH_SECRET=...
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   CLOUDINARY_CLOUD_NAME=...
#   CLOUDINARY_API_KEY=...
#   CLOUDINARY_API_SECRET=...
#   PAYSTACK_SECRET_KEY=sk_live_...
#   PAYSTACK_PUBLIC_KEY=pk_live_...
#
# After sync, verify:
#   FRONTEND_URL=https://concordiaorbis-platform-one.vercel.app
#   GOOGLE_REDIRECT_URI=https://concordiaorbis-platform.onrender.com/api/auth/google/callback

# ─── Vercel → Project → Settings → Environment Variables (Production) ─────
# BACKEND_URL=https://concordiaorbis-platform.onrender.com
# NEXT_PUBLIC_SITE_URL=https://concordiaorbis-platform-one.vercel.app
# NEXT_PUBLIC_API_URL=https://concordiaorbis-platform.onrender.com
# NEXT_PUBLIC_COMPANY_SITE_URL=https://concordiaorbis-website.vercel.app
# NEXT_PUBLIC_GOOGLE_DEV_MODE=false

# ─── Google Cloud Console → OAuth client ───────────────────────────────────
# Authorized JavaScript origins:
#   https://concordiaorbis-platform-one.vercel.app
#   http://localhost:3000
# Authorized redirect URIs:
#   https://concordiaorbis-platform.onrender.com/api/auth/google/callback
#   http://localhost:3000/auth/google/callback
# ─── Paystack Dashboard → Settings → API Keys & Webhooks ───────────────────
# Secret key → Render PAYSTACK_SECRET_KEY
# Public key  → Render PAYSTACK_PUBLIC_KEY
# Webhook URL:
#   https://concordiaorbis-platform.onrender.com/api/payments/paystack/webhook
# Callback is sent per transaction to:
#   https://concordiaorbis-platform-one.vercel.app/payments/callback
